{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaddbs.org/schemas/dual_frequency_workflow.schema.json",
  "title": "Dual-frequency workflow profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_type",
    "model_profiles",
    "output",
    "selection",
    "execution",
    "storage"
  ],
  "properties": {
    "profile_type": {"const": "dual_frequency_workflow"},
    "model_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_voxel",
        "normative_fiber",
        "individualized_seed_target"
      ],
      "properties": {
        "direct_voxel": {"type": "string", "minLength": 1},
        "normative_fiber": {"type": "string", "minLength": 1},
        "individualized_seed_target": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {"type": "string", "pattern": "^/", "minLength": 2}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "connectomes"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "all",
              "reference_voxel",
              "reference_fiber",
              "reference_individualized",
              "addon_voxel",
              "addon_fiber",
              "addon_individualized"
            ]
          }
        },
        "connectomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "through",
        "resume",
        "force",
        "continue_on_endpoint_failure",
        "allow_expensive_producers",
        "workers"
      ],
      "properties": {
        "through": {"enum": ["observed", "formal", "sensitivity", "report"]},
        "resume": {"type": "boolean"},
        "force": {"type": "boolean"},
        "continue_on_endpoint_failure": {"type": "boolean"},
        "allow_expensive_producers": {"type": "boolean"},
        "workers": {"type": "integer", "minimum": 1}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_root", "run_root"],
      "properties": {
        "cache_root": {"type": "string", "pattern": "^/", "minLength": 2},
        "run_root": {"type": "string", "pattern": "^/", "minLength": 2},
        "delete_run_cache_on_success": {"type": "boolean", "default": true}
      }
    }
  }
}
