{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaddbs.org/schemas/direct_voxel_model_v1.schema.json",
  "title": "Direct voxel model profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_type",
    "model_set_id",
    "output",
    "scales",
    "endpoint_pair",
    "frequency_classes",
    "shared",
    "addon"
  ],
  "properties": {
    "schema_version": {"const": "direct_voxel_model_v1"},
    "profile_type": {"const": "direct_voxel_model"},
    "model_set_id": {"type": "string", "minLength": 1},
    "output": {"$ref": "#/$defs/output"},
    "scales": {"$ref": "#/$defs/scales"},
    "endpoint_pair": {"$ref": "#/$defs/endpointPair"},
    "frequency_classes": {"$ref": "#/$defs/frequencyClasses"},
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "hard_computability",
        "formal_resampling",
        "selected_source_sensitivity"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "hard_computability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n_subjects_min", "n_voxels_full_min", "fold_n_voxels_min"],
          "properties": {
            "n_subjects_min": {"type": "integer", "minimum": 2},
            "n_voxels_full_min": {"type": "integer", "minimum": 1},
            "fold_n_voxels_min": {"type": "integer", "minimum": 1}
          }
        },
        "formal_resampling": {"$ref": "#/$defs/formalResampling"},
        "selected_source_sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tau_multipliers"],
          "properties": {
            "tau_multipliers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "addon": {"$ref": "#/$defs/addon"}
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {"type": "string", "pattern": "^/", "minLength": 2}
      }
    },
    "scales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"}
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "program_id"],
      "properties": {
        "phase_id": {"type": "string", "minLength": 1},
        "program_id": {"type": "integer", "minimum": 0}
      }
    },
    "endpointPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "reference", "addon"],
      "properties": {
        "baseline": {"$ref": "#/$defs/binding"},
        "reference": {"$ref": "#/$defs/binding"},
        "addon": {"$ref": "#/$defs/binding"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "lower_inclusive", "upper", "upper_inclusive"],
      "properties": {
        "lower": {"type": ["number", "null"], "minimum": 0},
        "lower_inclusive": {"type": "boolean"},
        "upper": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "upper_inclusive": {"type": "boolean"}
      }
    },
    "frequencyClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "addon"],
      "properties": {
        "reference": {"$ref": "#/$defs/interval"},
        "addon": {"$ref": "#/$defs/interval"}
      }
    },
    "sourceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tau_v_per_m", "coverage_subjects_min"],
      "properties": {
        "tau_v_per_m": {"type": "number", "exclusiveMinimum": 0},
        "coverage_subjects_min": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_specified", "scan", "minimum_adjacent_passing_cells"],
      "properties": {
        "pre_specified": {"$ref": "#/$defs/sourceCell"},
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tau_v_per_m", "coverage_subjects_min"],
          "properties": {
            "tau_v_per_m": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "number", "exclusiveMinimum": 0}
            },
            "coverage_subjects_min": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        },
        "minimum_adjacent_passing_cells": {"type": "integer", "minimum": 0}
      }
    },
    "formalResampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "permutation_resamples",
        "bootstrap_resamples",
        "jitter_resamples",
        "jitter_translation_fwhm_mm"
      ],
      "properties": {
        "seed": {"type": "integer"},
        "permutation_resamples": {"type": "integer", "minimum": 1},
        "bootstrap_resamples": {"type": "integer", "minimum": 1},
        "jitter_resamples": {"type": "integer", "minimum": 1},
        "jitter_translation_fwhm_mm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "adequateSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_median_out_support_max",
        "subject_out_support_threshold",
        "subject_fraction_max"
      ],
      "properties": {
        "cohort_median_out_support_max": {"type": "number", "minimum": 0, "maximum": 1},
        "subject_out_support_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "subject_fraction_max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "invalidSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_median_out_support_min_exclusive",
        "subject_out_support_threshold",
        "subject_fraction_min_exclusive",
        "individual_out_support_min_exclusive"
      ],
      "properties": {
        "cohort_median_out_support_min_exclusive": {"type": "number", "minimum": 0, "maximum": 1},
        "subject_out_support_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "subject_fraction_min_exclusive": {"type": "number", "minimum": 0, "maximum": 1},
        "individual_out_support_min_exclusive": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_reference_support"],
      "properties": {
        "delta_reference_support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adequate", "invalid"],
          "properties": {
            "adequate": {"$ref": "#/$defs/adequateSupport"},
            "invalid": {"$ref": "#/$defs/invalidSupport"}
          }
        }
      }
    }
  }
}
