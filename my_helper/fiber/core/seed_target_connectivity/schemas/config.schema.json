{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seed-target connectivity configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probability_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probability_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "roi_thresholds": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "intersection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "segment_aware_voxel_traversal"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fiber_chunk_size": {
          "type": "integer",
          "minimum": 1
        },
        "cache_membership": {
          "type": "boolean"
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
