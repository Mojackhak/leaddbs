{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seed-target connectivity batch configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inputs", "output"],
  "properties": {
    "schema_version": {"const": 2},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_atlas_root", "seed_rois", "connectome"],
      "properties": {
        "target_atlas_root": {"type": "string", "minLength": 1},
        "seed_rois": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "not": {"enum": [".", ".."]}
          },
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "connectome": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_root", "run_name"],
      "properties": {
        "output_root": {"type": "string", "minLength": 1},
        "run_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "not": {"enum": [".", ".."]}
        },
        "cache_root": {"type": "string", "minLength": 1}
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probability_threshold": {
          "anyOf": [
            {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probability_threshold": {
          "anyOf": [
            {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "roi_thresholds": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fiber_chunk_size": {"type": "integer", "minimum": 1},
        "cache_membership": {"type": "boolean"}
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  }
}
