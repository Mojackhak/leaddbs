{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_type", "scales"],
  "properties": {
    "schema_version": {"const": "four_model_v1"},
    "profile_type": {"const": "scale_profile"},
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scale_id", "label", "direction", "minimum_subjects", "endpoint_bindings"],
        "properties": {
          "scale_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "direction": {"enum": ["lower", "higher"]},
          "minimum_subjects": {"const": 12},
          "endpoint_bindings": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "required": ["frequency_1_reference"],
            "properties": {
              "frequency_1_reference": {"$ref": "#/$defs/binding"},
              "frequency_2_addon_chronic": {"$ref": "#/$defs/binding"},
              "frequency_2_addon_immediate": {"$ref": "#/$defs/binding"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "phase"],
      "properties": {
        "protocol": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1}
      }
    }
  }
}
