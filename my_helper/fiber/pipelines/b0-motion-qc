#!/usr/bin/env python3
"""YAML entry point for read-only multi-b0 motion QC."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


REPO_ROOT = Path(__file__).resolve().parents[3]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from my_helper.fiber.core.dwi.b0_motion_qc import B0MotionQcError, run


def main() -> int:
    parser = argparse.ArgumentParser(prog="b0-motion-qc")
    parser.add_argument("--config", type=Path, required=True)
    args = parser.parse_args()
    try:
        result = run(args.config)
    except (B0MotionQcError, OSError, ValueError) as exc:
        print(json.dumps({"status": "error", "error": str(exc)}, indent=2), file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
